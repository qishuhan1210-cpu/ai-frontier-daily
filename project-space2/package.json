{
  "name": "wechat-mp-automation",
  "version": "1.0.0",
  "description": "微信公众号和小红书页面自动化",
  "bin": {
    "wechat-mp": "src/wechat.ts",
    "xhs": "src/xiaohongshu.ts"
  },
  "scripts": {
    "wechat-mp": "npx tsx src/wechat.ts",
    "wechat-save-auth": "npx tsx src/wechat.ts save-auth",
    "wechat-publish": "npx tsx src/wechat.ts publish",
    "xhs": "npx tsx src/xiaohongshu.ts",
    "xhs-save-auth": "npx tsx src/xiaohongshu.ts save-auth",
    "xhs-publish": "npx tsx src/xiaohongshu.ts publish",
    "install-browsers": "npx playwright install"
  },
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "@types/js-yaml": "^4.0.9",
    "commander": "^14.0.3",
    "js-yaml": "^4.2.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
